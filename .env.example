# Copy to .env for local development. Never commit .env.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campus_found
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:3000
UPLOAD_DIR=./server/uploads
SEED_DEMO_DATA=true

# Demo values are used only by the development seed. Change them before any shared demo.
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=Student@123
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin@123
